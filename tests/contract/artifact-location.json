{
  "kind": "artifact",
  "note": "产物落点：只给相对工作区根的路径——声明了按声明的（绝对路径原样），没声明落 artifacts/<种类>/<任务名>.md；流水是任务文件本身。拼上目录是平台的事。",
  "cases": [
    {
      "note": "没声明：报告落默认处",
      "name": "甲",
      "artifacts": {},
      "artifact": "report",
      "expect": "artifacts/report/甲.md"
    },
    {
      "note": "没声明：日志同样落默认处",
      "name": "甲",
      "artifacts": {},
      "artifact": "journal",
      "expect": "artifacts/journal/甲.md"
    },
    {
      "note": "流水就是任务文件本身，与声明无关",
      "name": "甲",
      "artifacts": { "log": "other.md" },
      "artifact": "log",
      "expect": "tasks/甲.yaml"
    },
    {
      "note": "声明了相对路径：原样（相对工作区根）",
      "name": "甲",
      "artifacts": { "report": "report/甲.md" },
      "artifact": "report",
      "expect": "report/甲.md"
    },
    {
      "note": "声明了绝对路径：原样",
      "name": "甲",
      "artifacts": { "report": "/elsewhere/甲.md" },
      "artifact": "report",
      "expect": "/elsewhere/甲.md"
    },
    {
      "note": "声明成空白：等于没声明",
      "name": "甲",
      "artifacts": { "report": "  " },
      "artifact": "report",
      "expect": "artifacts/report/甲.md"
    }
  ]
}
