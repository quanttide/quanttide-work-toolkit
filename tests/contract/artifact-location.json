{
  "kind": "artifact",
  "note": "产物落点：只给相对工作区根的路径——声明了按声明的（绝对路径原样），没声明落 artifacts/<产物的名字>/<任务名>.md。拼上目录是平台的事。流水不是产物（{{log}} 换的是任务文件本身，见 expand-placeholders）。",
  "cases": [
    {
      "note": "没声明：报告落默认处",
      "name": "甲",
      "artifacts": {},
      "artifact": "report",
      "expect": "artifacts/report/甲.md"
    },
    {
      "note": "没声明：换个名字同样落默认处——产物不限种类",
      "name": "甲",
      "artifacts": {},
      "artifact": "history",
      "expect": "artifacts/history/甲.md"
    },
    {
      "note": "声明了相对路径：原样（相对工作区根）",
      "name": "甲",
      "artifacts": { "report": "report/甲.md" },
      "artifact": "report",
      "expect": "report/甲.md"
    },
    {
      "note": "声明了绝对路径：原样",
      "name": "甲",
      "artifacts": { "report": "/elsewhere/甲.md" },
      "artifact": "report",
      "expect": "/elsewhere/甲.md"
    },
    {
      "note": "声明成空白：等于没声明",
      "name": "甲",
      "artifacts": { "report": "  " },
      "artifact": "report",
      "expect": "artifacts/report/甲.md"
    }
  ]
}
