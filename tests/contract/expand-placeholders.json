{
  "kind": "expand",
  "note": "占位换成本次任务的落点：与 artifact 同一处算（声明了按声明的，没声明落默认处）。",
  "task": {
    "name": "甲",
    "artifacts": {}
  },
  "cases": [
    {
      "input": "见 {{report}}",
      "expect": "见 artifacts/report/甲.md"
    },
    {
      "input": "{{journal}}",
      "expect": "artifacts/journal/甲.md"
    },
    {
      "input": "{{log}}",
      "expect": "tasks/甲.yaml"
    },
    {
      "input": "{{artifacts}}/y",
      "expect": "artifacts/y"
    },
    {
      "input": "没有占位",
      "expect": "没有占位"
    },
    {
      "input": "{{unknown}}",
      "expect": "{{unknown}}",
      "note": "不认识的占位原样留着（读定义时已经拦过）"
    },
    {
      "note": "声明了就用声明的",
      "artifacts": { "report": "report/甲.md" },
      "input": "{{report}}",
      "expect": "report/甲.md"
    }
  ]
}
