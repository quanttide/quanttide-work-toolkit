{
  "kind": "expand",
  "base": "/d",
  "cases": [
    {
      "input": "{{report}}/x.md",
      "expect": "/d/artifacts/report/x.md"
    },
    {
      "input": "{{journal}}",
      "expect": "/d/artifacts/journal"
    },
    {
      "input": "{{log}}",
      "expect": "/d/tasks"
    },
    {
      "input": "{{artifacts}}/y",
      "expect": "/d/artifacts/y"
    },
    {
      "base": "/d/",
      "input": "{{report}}/x.md",
      "expect": "/d/artifacts/report/x.md"
    },
    {
      "base": "/d//",
      "input": "{{journal}}",
      "expect": "/d/artifacts/journal"
    },
    {
      "base": "",
      "input": "{{log}}",
      "expect": "/tasks"
    },
    {
      "base": "rel",
      "input": "{{log}}",
      "expect": "rel/tasks"
    }
  ]
}
