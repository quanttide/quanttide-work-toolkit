{
  "kind": "expand",
  "note": "占位换成本次任务的落点：与 artifact 同一处算（声明了按声明的，没声明落默认处）。",
  "base": "/d",
  "task": {
    "name": "甲",
    "artifacts": {}
  },
  "cases": [
    {
      "input": "见 {{report}}",
      "expect": "见 /d/artifacts/report/甲.md"
    },
    {
      "input": "{{journal}}",
      "expect": "/d/artifacts/journal/甲.md"
    },
    {
      "input": "{{log}}",
      "expect": "/d/tasks/甲.yaml"
    },
    {
      "input": "{{artifacts}}/y",
      "expect": "/d/artifacts/y"
    },
    {
      "input": "没有占位",
      "expect": "没有占位"
    },
    {
      "input": "{{unknown}}",
      "expect": "{{unknown}}",
      "note": "不认识的占位原样留着（读定义时已经拦过）"
    },
    {
      "base": "/d/",
      "input": "{{report}}",
      "expect": "/d/artifacts/report/甲.md"
    },
    {
      "base": "/d//",
      "input": "{{journal}}",
      "expect": "/d/artifacts/journal/甲.md"
    },
    {
      "base": "",
      "input": "{{report}}",
      "expect": "/artifacts/report/甲.md"
    },
    {
      "base": "rel",
      "input": "{{log}}",
      "expect": "rel/tasks/甲.yaml"
    },
    {
      "note": "声明了就用声明的",
      "artifacts": {
        "report": "report/甲.md"
      },
      "input": "{{report}}",
      "expect": "/d/report/甲.md"
    }
  ]
}
